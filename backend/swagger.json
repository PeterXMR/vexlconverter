{
  "openapi": "3.0.0",
  "info": {
    "title": "Vexl Converter API",
    "version": "0.2.0",
    "description": "Multi-cryptocurrency converter with price alerts, historical charts, and universal conversion"
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "API is healthy"
          }
        }
      }
    },
    "/api/cryptos": {
      "get": {
        "summary": "List supported cryptocurrencies",
        "description": "Returns all supported crypto IDs, symbols, and names",
        "responses": {
          "200": {
            "description": "List of supported cryptos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "bitcoin"
                          },
                          "symbol": {
                            "type": "string",
                            "example": "BTC"
                          },
                          "name": {
                            "type": "string",
                            "example": "Bitcoin"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/prices/latest": {
      "get": {
        "summary": "Get latest price for a cryptocurrency",
        "parameters": [
          {
            "name": "crypto",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "bitcoin"
            },
            "description": "CoinGecko crypto ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Latest price data"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "No price data available"
          }
        }
      }
    },
    "/api/prices/all": {
      "get": {
        "summary": "Get latest prices for all supported cryptos",
        "responses": {
          "200": {
            "description": "All latest prices keyed by crypto ID"
          }
        }
      }
    },
    "/api/prices/history": {
      "get": {
        "summary": "Get historical price data",
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "24h",
                "7d",
                "30d",
                "1y"
              ],
              "default": "24h"
            }
          },
          {
            "name": "crypto",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "bitcoin"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historical price data with timestamps"
          },
          "400": {
            "description": "Validation error"
          },
          "429": {
            "description": "Too Many Requests — rate limit exceeded"
          }
        }
      }
    },
    "/api/convert": {
      "post": {
        "summary": "Convert crypto to fiat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "crypto": {
                    "type": "string",
                    "default": "bitcoin"
                  },
                  "amount": {
                    "type": "number",
                    "example": 0.01
                  },
                  "btc_amount": {
                    "type": "number",
                    "description": "Backwards-compatible alias for amount"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversion result with USD and EUR amounts"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "No price data"
          },
          "413": {
            "description": "Request body exceeds 64 KB"
          }
        }
      }
    },
    "/api/convert/reverse": {
      "post": {
        "summary": "Convert fiat to crypto",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fiat_amount"
                ],
                "properties": {
                  "fiat_amount": {
                    "type": "number",
                    "example": 500
                  },
                  "fiat_currency": {
                    "type": "string",
                    "enum": [
                      "usd",
                      "eur"
                    ],
                    "default": "usd"
                  },
                  "crypto": {
                    "type": "string",
                    "default": "bitcoin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Crypto amount equivalent"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "No price data"
          },
          "413": {
            "description": "Request body exceeds 64 KB"
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "summary": "List active price alerts",
        "responses": {
          "200": {
            "description": "Array of active (non-triggered) alerts"
          }
        },
        "security": [
          {
            "AlertTokens": []
          }
        ]
      },
      "post": {
        "summary": "Create a price alert",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "target_price"
                ],
                "properties": {
                  "target_price": {
                    "type": "number",
                    "example": 100000,
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000000
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "usd",
                      "eur"
                    ],
                    "default": "usd"
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "above",
                      "below"
                    ],
                    "default": "above"
                  },
                  "crypto": {
                    "type": "string",
                    "default": "bitcoin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Alert created"
          },
          "400": {
            "description": "Validation error — bad body shape, type, or value"
          },
          "429": {
            "description": "Too Many Requests — rate limit exceeded"
          },
          "413": {
            "description": "Request body exceeds 64 KB"
          }
        }
      }
    },
    "/api/alerts/{id}": {
      "delete": {
        "summary": "Delete a price alert",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Alert deleted"
          },
          "403": {
            "description": "Forbidden — missing or wrong X-Alert-Token. Same response for non-existent alert ids to prevent enumeration."
          }
        },
        "security": [
          {
            "AlertToken": []
          }
        ]
      }
    },
    "/api/alerts/triggered": {
      "get": {
        "summary": "Get recently triggered alerts",
        "description": "Returns alerts triggered within the last 60 seconds (for polling)",
        "responses": {
          "200": {
            "description": "Array of triggered alerts"
          }
        },
        "security": [
          {
            "AlertTokens": []
          }
        ]
      }
    },
    "/api/alerts/ack": {
      "post": {
        "summary": "Acknowledge triggered alerts",
        "description": "Marks triggered alerts as seen by the client so they stop appearing in the triggered list.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "example": [
                      1,
                      2,
                      3
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledgement count returned"
          },
          "400": {
            "description": "ids array missing or empty"
          },
          "429": {
            "description": "Too Many Requests — rate limit exceeded"
          },
          "413": {
            "description": "Request body exceeds 64 KB"
          }
        },
        "security": [
          {
            "AlertToken": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AlertToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Alert-Token",
        "description": "Per-alert HMAC token returned once by POST /api/alerts. Required to delete or acknowledge that specific alert."
      },
      "AlertTokens": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Alert-Tokens",
        "description": "Comma-separated list of per-alert HMAC tokens. Required to list alerts owned by the caller."
      }
    }
  }
}
